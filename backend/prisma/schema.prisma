// SpiritApex - Modelo de datos completo.
// Mapea db-er.mermaid: tablas en snake_case via @@map y campos en camelCase,
// siguiendo la convencion ya establecida en el cliente Prisma del proyecto.
//
// Convenciones:
//   * id      -> uuid v4 generado por la aplicacion
//   * dinero  -> Decimal(12,2) (nunca float)
//   * fechas  -> timestamptz, createdAt/updatedAt en toda entidad
//   * borrado -> logico (deletedAt) en VEHICLES y CHATS; el resto es fisico
//     segun el impacto en la trazabilidad (cascade o restrict)

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

// El nombre debe ser el de la extension en Postgres, que es `vector`.
// `pgvector` es el nombre del proyecto/imagen, no el de la extension: con
// "pgvector" Prisma emite `CREATE EXTENSION "pgvector"` y Postgres responde
// "extension pgvector is not available" (el control file es vector.control).
datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Enumeradores
// ---------------------------------------------------------------------------

/// Perfil de la cuenta. BUYER y SELLER no son excluyentes: un vendedor puede
/// tambien comprar. ADMIN añade capacidades de moderacion.
enum Role {
  BUYER
  SELLER
  ADMIN
}

/// Como se ofrece el vehiculo.
enum SaleType {
  DIRECT_SALE
  AUCTION
  BOTH
}

/// Ciclo de vida comercial. DRAFT cubre el alta antes de cumplir los
/// requisitos de enlistado (VIN + placa + DUI del vendedor).
enum VehicleStatus {
  DRAFT
  AVAILABLE
  IN_AUCTION
  RESERVED
  SOLD
}

/// Verificacion del documento de identidad del vendedor.
enum DuiStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

/// Combustible, tal como lo filtra el catalogo del cliente.
enum Fuel {
  GASOLINE
  DIESEL
  ELECTRIC
  HYBRID
}

/// Segmento comercial. No se deriva del combustible: un auto electrico es una
/// categoria aparte de un SUV, y el catalogo filtra por las dos.
enum Category {
  SUV
  SEDAN
  SPORT
  ELECTRIC
  PICKUP
  COMPACT
}

enum Condition {
  NEW
  LIKE_NEW
  USED
  FOR_PARTS
}

/// Origen del mensaje en una conversacion de compraventa.
enum ChatType {
  PURCHASE
  SALE
  AUCTION_WIN
}

enum MessageType {
  TEXT
  IMAGE
  OFFER
}

/// Quien envio el mensaje. Persistir la conversacion con el modelo permite
/// auditar y reconstruir el diagnostico sin volver a llamar a Gemini.
enum DiagnosticSender {
  USER
  AI_ASSISTANT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum AuctionStatus {
  PENDING
  ACTIVE
  FINISHED
  CANCELLED
  /// Terminó con ganador pero la orden no se pagó (venció o la cancelaron): la subasta queda cerrada sin venta.
  CLOSED
}

enum DiagnosticSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ---------------------------------------------------------------------------
// Nucleo: USERS
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  /// Hash bcrypt de la contrasena. Nunca se selecciona en listados publicos.
  passwordHash  String
  fullName      String
  phoneNumber   String?
  /// Documento de identidad del vendedor. Requisito para enlistar cualquier
  /// vehiculo (regla de negocio de la plataforma, ver db-er.mermaid).
  duiPhotoUrl   String?
  /// Estado de la verificacion del documento. NONE es el valor inicial de toda
  /// cuenta nueva: sin DUI cargado no se puede publicar ningun vehiculo.
  duiStatus     DuiStatus @default(NONE)
  /// Momento en que un ADMIN (o el revisor automatico) aprobo el documento.
  /// Es lo que habilita VehicleStatus fuera de DRAFT.
  duiVerifiedAt DateTime? @db.Timestamptz(3)
  role          Role      @default(BUYER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  // 1:N - vehiculos que publica
  vehicles        Vehicle[]
  // 1:N - subastas que organizes
  hostedAuctions  Auction[]         @relation("AuctionSeller")
  // 1:N - compras directas
  orders          Order[]           @relation("OrderBuyer")
  // 1:N - ventas directas
  sales           Order[]           @relation("OrderSeller")
  // 1:N - pujas
  bids            Bid[]             @relation("BidBidder")
  // 1:N - subastas donde va ganando
  winningAuctions Auction[]         @relation("AuctionCurrentWinner")
  // 1:N - conversaciones. El rol es contextual a la conversacion, por eso el
  // mismo id aparece en ambas relaciones.
  chatsAsBuyer    Chat[]            @relation("ChatBuyer")
  chatsAsSeller   Chat[]            @relation("ChatSeller")
  // 1:N - mensajes enviados
  messages        Message[]         @relation("MessageSender")
  // 1:N - diagnosticos de IA
  diagnostics     AiDiagnostic[]
  // N:M - favoritos del catalogo
  favorites       VehicleFavorite[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Catalogo: VEHICLES / VEHICLE_IMAGES
// ---------------------------------------------------------------------------

model Vehicle {
  id                   String                      @id @default(uuid()) @db.Uuid
  sellerId             String                      @db.Uuid
  /// VIN: identificador fisico del vehiculo, unico en la plataforma.
  vin                  String                      @unique
  licensePlate         String                      @unique
  brand                String
  model                String
  year                 Int
  mileage              Int
  transmission         Transmission
  fuel                 Fuel
  category             Category
  /// Ficha tecnica que la app muestra como filas de "Mecanicas". Se guardan
  /// como texto libre porque cada marca publica la potencia y el motor a su
  /// manera ("385 HP", "Doble motor electrico") y no hay nada que calcular.
  engine               String
  power                String
  drivetrain           String
  condition            Condition                   @default(USED)
  color                String?
  /// Precio de referencia para venta directa. La subasta usa su propio
  /// startingPrice en AUCTIONS.
  basePrice            Decimal                     @db.Decimal(12, 2)
  saleType             SaleType
  status               VehicleStatus               @default(DRAFT)
  /// Copia de marca + modelo en minusculas y sin acentos, para buscar. Existe
  /// porque la extension `unaccent` de Postgres no esta disponible: con
  /// `ILIKE` a secas "skoda" no encuentra "Skoda". Normalizando en la app se
  /// resuelve sin depender de la instalacion de la base. `COLLATE "C"` para que
  /// la comparacion sea igual en cualquier instalacion.
  searchText           String                      @default("")
  description          String?
  /// Embedding de la descripcion para busqueda semantica asistida por IA.
  /// `Unsupported` porque Prisma no expone el tipo pgvector de forma nativa.
  descriptionEmbedding Unsupported("vector(768)")?
  deletedAt            DateTime?                   @db.Timestamptz(3)
  createdAt            DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @db.Timestamptz(3)

  seller      User              @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  // 1:N - galeria
  images      VehicleImage[]
  // 1:N - historial de ordenes; solo una puede estar activa (indice unico parcial en la migracion)
  orders      Order[]
  // 1:1 - como mucho una subasta por vehiculo
  auction     Auction?
  // 1:N - conversaciones que referencian este vehiculo
  chats       Chat[]
  // 1:N - diagnosticos de IA hechos sobre este vehiculo
  diagnostics AiDiagnostic[]
  // N:M - marcado como favorito
  favoritedBy VehicleFavorite[]

  @@index([sellerId])
  @@index([status, saleType])
  @@index([brand, model])
  @@index([basePrice])
  @@map("vehicles")
}

model VehicleImage {
  id        String   @id @default(uuid()) @db.Uuid
  vehicleId String   @db.Uuid
  url       String
  /// Ruta del objeto en Supabase Storage. Se guarda aparte de la url porque
  /// es lo unico con lo que se puede derivar el recurso para borrarlo: la url
  /// puede llevar transformaciones y no sirve para reconstruirlo.
  publicId  String?
  /// Orden de presentacion en la galeria (0 = portada).
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, position])
  @@map("vehicle_images")
}

// ---------------------------------------------------------------------------
// N:M explicito: favoritos del catalogo
// ---------------------------------------------------------------------------

/// Junction model explicito (no el N:M implicito de Prisma) para poder
/// guardar `createdAt` del marcado, que el implicito no soporta.
model VehicleFavorite {
  userId    String   @db.Uuid
  vehicleId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([userId, vehicleId])
  @@index([vehicleId])
  @@map("vehicle_favorites")
}

// ---------------------------------------------------------------------------
// Ventas directas: ORDERS
// ---------------------------------------------------------------------------

/// Medio de pago simulado. No hay pasarela real: el proyecto es academico.
enum PaymentMethod {
  CARD
  BANK_TRANSFER
}

/// De donde nace la orden: compra directa desde la ficha o cierre de una subasta ganada.
enum OrderOrigin {
  DIRECT_SALE
  AUCTION
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model Order {
  id               String        @id @default(uuid()) @db.Uuid
  /// Sin @unique: una orden cancelada o expirada no puede bloquear para siempre el vehiculo. La regla
  /// "una orden activa por vehiculo" la impone el indice unico parcial orders_active_vehicle_key.
  vehicleId        String        @db.Uuid
  buyerId          String        @db.Uuid
  sellerId         String        @db.Uuid
  /// Numero legible de la orden (ORD-2026-000123). Unico para soporte.
  orderNumber      String        @unique
  /// Snapshot del precio al cerrar la operacion: si el vehiculo cambia de
  /// precio despues, el historico contractual no debe moverse.
  subtotal         Decimal       @db.Decimal(12, 2)
  /// Tasa de impuesto aplicada en el momento de la compra (0.13).
  taxRate          Decimal       @db.Decimal(5, 4)
  taxAmount        Decimal       @db.Decimal(12, 2)
  totalAmount      Decimal       @db.Decimal(12, 2)
  status           OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus    PaymentStatus @default(PENDING)
  /// Referencia del gateway de pagos. En el simulador es un id `mock_`; queda
  /// unico para que un eventual webhook real sea idempotente.
  paymentGatewayId String?       @unique
  /// Sesion de pago creada por checkout-session. Es unica por orden porque solo
  /// puede haber una PaymentIntent viva a la vez.
  gatewaySessionId String?       @unique
  origin           OrderOrigin   @default(DIRECT_SALE)
  paymentMethod    PaymentMethod?
  /// Lo que se puede mostrar del pago: "VISA •••• 4242" o la referencia de la transferencia. Nunca el numero completo.
  paymentReference String?
  /// Limite para pagar; vencido, el job cancela la orden y libera el vehiculo.
  expiresAt        DateTime?     @db.Timestamptz(3)
  completedAt      DateTime?     @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  buyer   User    @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller  User    @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  chat    Chat?

  @@index([vehicleId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([status, expiresAt])
  @@map("orders")
}

// ---------------------------------------------------------------------------
// Subastas: AUCTIONS / BIDS
// ---------------------------------------------------------------------------

model Auction {
  id              String        @id @default(uuid()) @db.Uuid
  vehicleId       String        @unique @db.Uuid
  sellerId        String        @db.Uuid
  startingPrice   Decimal       @db.Decimal(12, 2)
  /// Puja vigente, denormalizada para no calcular MAX/COUNT en cada lectura del
  /// socket. AuctionService la actualiza en la misma transaccion que inserta
  /// la puja, de modo que nunca diverge de BIDS.
  currentBid      Decimal?      @db.Decimal(12, 2)
  /// Sobreoferta minima, para frenar pujas spam.
  minBidIncrement Decimal       @default(10) @db.Decimal(12, 2)
  currentWinnerId String?       @db.Uuid
  startTime       DateTime      @db.Timestamptz(3)
  endTime         DateTime      @db.Timestamptz(3)
  status          AuctionStatus @default(PENDING)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  vehicle       Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  seller        User    @relation("AuctionSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  currentWinner User?   @relation("AuctionCurrentWinner", fields: [currentWinnerId], references: [id], onDelete: SetNull)
  // 1:N - historial completo de pujas
  bids          Bid[]

  @@index([status, startTime, endTime])
  @@index([sellerId])
  @@index([currentWinnerId])
  @@map("auctions")
}

model Bid {
  id        String   @id @default(uuid()) @db.Uuid
  auctionId String   @db.Uuid
  bidderId  String   @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User    @relation("BidBidder", fields: [bidderId], references: [id], onDelete: Restrict)

  // Indice del hot path de subastas: maxima puja por subasta.
  @@index([auctionId, amount])
  @@index([bidderId])
  @@map("bids")
}

// ---------------------------------------------------------------------------
// Mensajeria: CHATS / MESSAGES
// ---------------------------------------------------------------------------

model Chat {
  id        String    @id @default(uuid()) @db.Uuid
  vehicleId String?   @db.Uuid
  buyerId   String    @db.Uuid
  sellerId  String    @db.Uuid
  chatType  ChatType  @default(PURCHASE)
  /// Conversacion que origino la orden cuando la oferta fue aceptada. Es unico
  /// porque una orden nace de una sola oferta aceptada.
  orderId   String?   @unique @db.Uuid
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  buyer    User      @relation("ChatBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller   User      @relation("ChatSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // 1:N - hilo de la conversacion
  messages Message[]

  // Evita abrir varias conversaciones del mismo par sobre el mismo vehiculo.
  // vehicleId es opcional (preguntas generales), asi que el indice unico
  // parcial solo aplica cuando hay vehiculo de por medio.
  @@unique([vehicleId, buyerId, sellerId])
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
  @@map("chats")
}

model Message {
  id          String      @id @default(uuid()) @db.Uuid
  chatId      String      @db.Uuid
  senderId    String      @db.Uuid
  content     String
  messageType MessageType @default(TEXT)
  /// Payload de IMAGE/OFFER (url de la imagen, monto de la oferta).
  metadata    Json?
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([chatId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Asistente de diagnostico: AI_DIAGNOSTICS / AI_DIAGNOSTIC_MESSAGES
// ---------------------------------------------------------------------------

model AiDiagnostic {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @db.Uuid
  /// Opcional: permite diagnosticar desde la ficha de un vehiculo del catalogo.
  vehicleId    String?             @db.Uuid
  /// Datos del vehiculo al que aplica el diagnostico. Opcionales porque el
  /// usuario puede describir la falla sin tener identificado el modelo.
  vehicleBrand String?
  vehicleModel String?
  vehicleYear  Int?
  mileage      Int?
  /// Descripcion corta de la falla declarada por el usuario.
  title        String
  /// Sintomas estructurados que se inyectan como contexto en el prompt.
  symptoms     Json?
  /// Diagnostico final emitido por el modelo, listo para mostrar.
  summary      String?
  /// Confianza del modelo (0..1) para priorizar y advertir al usuario.
  confidence   Float?
  /// Veredicto de seguridad: no autorizar la circulacion si es CRITICAL/HIGH.
  severity     DiagnosticSeverity?
  resolved     Boolean             @default(false)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle  Vehicle?              @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  messages AiDiagnosticMessage[]

  @@index([userId, createdAt])
  @@index([vehicleId])
  @@index([severity])
  @@map("ai_diagnostics")
}

model AiDiagnosticMessage {
  id             String           @id @default(uuid()) @db.Uuid
  diagnosticId   String           @db.Uuid
  sender         DiagnosticSender
  content        String
  /// Modelo que genero la respuesta (p. ej. `openai/gpt-oss-120b`). Permite
  /// auditar que respuestas produjo cada version del modelo.
  model          String?
  /// Turno del usuario que respondio el modelo, para reproducir la respuesta.
  promptSnapshot String?
  /// Intencion detectada y ids de vehiculos del catalogo recomendados en esta respuesta.
  metadata       Json?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  diagnostic AiDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)

  @@index([diagnosticId, createdAt])
  @@index([sender])
  @@map("ai_diagnostic_messages")
}
