{
  "name": "spirit-store",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d db adminer",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db adminer",
    "db:migrate": "pnpm --filter @spirit-store/backend prisma:migrate",
    "db:deploy": "pnpm --filter @spirit-store/backend prisma:deploy",
    "db:generate": "pnpm --filter @spirit-store/backend prisma:generate",
    "db:push": "pnpm --filter @spirit-store/backend prisma:push",
    "db:studio": "pnpm --filter @spirit-store/backend prisma:studio",
    "db:seed": "pnpm --filter @spirit-store/backend prisma:seed",
    "app:start": "pnpm --filter @spirit-store/frontend start",
    "app:android": "pnpm --filter @spirit-store/frontend android",
    "app:ios": "pnpm --filter @spirit-store/frontend ios",
    "app:web": "pnpm --filter @spirit-store/frontend web",
    "api:dev": "pnpm --filter @spirit-store/backend dev",
    "api:build": "pnpm --filter @spirit-store/backend build",
    "api:start": "pnpm --filter @spirit-store/backend start",
    "dev": "concurrently -n api,app -c blue,green \"pnpm dev:api\" \"pnpm app:web\"",
    "dev:api": "pnpm --filter @spirit-store/backend dev",
    "dev:app": "pnpm --filter @spirit-store/frontend start",
    "prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "typecheck": "pnpm --filter @spirit-store/backend typecheck && pnpm --filter @spirit-store/frontend typecheck",
    "build": "pnpm --filter @spirit-store/backend build && pnpm --filter @spirit-store/frontend export:web"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "^57.0.25"
  },
  "packageManager": "pnpm@11.24.0"
}
