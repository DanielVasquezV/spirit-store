# ---------- PostgreSQL (docker-compose.yml & docker-compose.prod.yml) ----------
POSTGRES_DB=spirit_store
POSTGRES_USER=spirit
POSTGRES_PASSWORD=spirit_password
POSTGRES_PORT=5432
ADMINER_PORT=8080

# ---------- API (backend/src/config/env.ts) ----------
PORT=4000
DATABASE_URL=postgresql://spirit:spirit_password@localhost:5432/spirit_store?schema=public
CLIENT_URL=*

# ---------- Auth ----------
# Obligatorio. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
# Solo para `pnpm db:seed` (usuario admin@spirit.dev)
SEED_ADMIN_PASSWORD=change-me
# Clave de las cuentas demo (ana@, carlos@ y maria@spirit.dev)
SEED_DEMO_PASSWORD=spirit-demo-123

# ---------- IA (Groq, API compatible con OpenAI) ----------
# Gratis en https://console.groq.com/keys. Opcional en desarrollo; sin ella el asistente responde 503.
GROQ_API_KEY=
# Cambiando estas dos se usa otro proveedor compatible (DeepSeek: https://api.deepseek.com/v1, deepseek-chat).
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# ---------- Almacenamiento de archivos (Supabase Storage) ----------
# Gratis sin tarjeta. Panel del proyecto > Project Settings > API: copiar la Project URL y la clave service_role.
# La service_role solo vive en el backend: nunca la pongas en el frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket publico donde se guardan fotos y DUIs; si no existe, el backend lo crea en la primera subida
SUPABASE_STORAGE_BUCKET=spirit-store
# Carpeta raiz del media de la aplicacion dentro del bucket
STORAGE_FOLDER=spiritapex
# Techo por archivo, en MB
UPLOAD_MAX_FILE_SIZE_MB=8

# ---------- Documentacion ----------
# Swagger UI en /docs y el spec en /docs.json.
# En desarrollo siempre disponible. En produccion responde 404 salvo que se
# ponga en true: la UI deja disparar llamadas reales contra la API desplegada
# con el token que se teclee a mano.
SWAGGER_ENABLED=true

# ---------- Ordenes ----------
# Minutos para pagar una compra directa y horas para pagar una subasta ganada
ORDER_EXPIRY_MINUTES=30
AUCTION_ORDER_EXPIRY_HOURS=48

# ---------- Production (docker-compose.prod.yml) ----------
API_PORT=4000
WEB_PORT=8081
EXPO_PUBLIC_API_URL=http://localhost:4000